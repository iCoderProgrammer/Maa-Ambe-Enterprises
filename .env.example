# Copy to `.env.local` for development, and set the same names in the Vercel
# project (Settings → Environment Variables). NEVER put a real value in this
# file — it is committed.

# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------

# Absolute origin of the deployed site, no trailing slash.
# Read at BUILD time: canonicals, OG tags, sitemap.xml, robots.txt and JSON-LD
# are all generated from it. Leave it unset and the build bakes in
# http://localhost:3000 and a robots.txt that disallows every crawler, so the
# site is never indexed.
# On Vercel this falls back to the project's production domain, but only on a
# production build — set it explicitly so the value is never in doubt.
# Example: https://maa-ambe-enterprisesev.vercel.app
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Lead delivery — required before the forms are used in anger
# ---------------------------------------------------------------------------

# Where a submitted lead is POSTed as JSON: a CRM intake URL, an automation
# hook (Zapier/Make/n8n), an email relay, a Google Apps Script.
# Unset, leads fall through to the development mock, which on serverless
# hosting keeps them in per-instance memory and LOSES them — while still
# showing the customer a reference number.
# Server-only: no NEXT_PUBLIC_ prefix, never sent to the browser.
LEADS_WEBHOOK_URL=

# Optional. Sent as `Authorization: Bearer <token>` so the endpoint can reject
# anything that is not this site. Server-only.
LEADS_WEBHOOK_TOKEN=
